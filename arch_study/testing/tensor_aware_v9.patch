+/*
+ * Tensor-aware replacement policy (UROP project, SRM University-AP).
+ *
+ * A small decision tree, learned offline from Belady's OPT on AI-layer
+ * traces, predicts for every access whether the line is worth keeping
+ * ("cache-friendly") or not. Inputs per access:
+ *   role_id, cmd_id, used_next, dead      (software tensor hint + request kind)
+ *   first_touch, prev_dist_log2           (per-line history at this level)
+ *   t_retouch8, t_dist                    (per-tensor reuse counters)
+ * Insertion / promotion (Hawkeye-style RRIP, 3 bits):
+ *   keep  -> RRPV 0, other kept lines in the set age by 1 (max 6)
+ *   not   -> RRPV 7 (first to go)
+ * Victim: highest RRPV, oldest access first on ties (invalid lines first).
+ * Safety net: set dueling against LRU (sets with set % 64 == 0 behave as
+ * LRU, set % 64 == 1 always follow the tree, the rest follow the winner,
+ * 10-bit PSEL).
+ *
+ * The tensor hint (which physical range belongs to which tensor, its role and
+ * the layers that use it; the PC ranges of the layer functions) is read from
+ * a text file (hint_file). Without a hint file every access is "other".
+ */
+
+#ifndef __MEM_CACHE_REPLACEMENT_POLICIES_TENSOR_AWARE_RP_HH__
+#define __MEM_CACHE_REPLACEMENT_POLICIES_TENSOR_AWARE_RP_HH__
+
+#include <cstdint>
+#include <fstream>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "base/statistics.hh"
+#include "mem/cache/replacement_policies/base.hh"
+#include "mem/packet.hh"
+#include "sim/system.hh"
+
+namespace gem5
+{
+
+struct TensorAwareRPParams;
+
+namespace replacement_policy
+{
+
+class TensorAware : public Base
+{
+  protected:
+    struct TAReplData : ReplacementData
+    {
+        bool valid = false;
+        bool averse = true;      // RRPV 7
+        uint64_t keepStamp = 0;  // set keep-counter value at last keep access
+        uint64_t lastSeq = 0;    // access order (tie-break: oldest first)
+        int tensor = -1;         // Step 8: tensor of the line (dead demotion)
+    };
+
+    struct Range
+    {
+        Addr end;
+        int tensor;   // -1 = not a tensor
+        int role;
+        double cum = 0;  // Step 9: tensor bytes before this range
+    };
+
+    struct TensorStat
+    {
+        uint64_t n = 0;     // earlier accesses
+        uint64_t re = 0;    // earlier re-touches
+        double sumLd = 0;   // sum of log2(reuse distance / cache lines)
+    };
+
+    const int level;          // 2 or 3
+    const unsigned numSets;
+    const unsigned assoc;
+    const bool dueling;
+    const unsigned blkShift;
+    const double capLines;
+
+    // hint tables
+    std::map<Addr, Range> ranges;                    // start -> range
+    std::vector<std::pair<Addr, Addr>> layerPC;      // layer k at [k - 1]
+    std::vector<uint32_t> users;                     // tensor -> layer mask
+    std::vector<uint64_t> tbytes;                    // tensor -> bytes
+
+    // state
+    uint64_t seq = 0;
+    std::vector<uint64_t> setKeep;
+    struct LineHist
+    {
+        uint64_t seq;     // last access
+        uint32_t count;   // accesses so far
+        bool lastPf;      // Step 7: previous access was a prefetch fill
+    };
+    std::unordered_map<Addr, LineHist> lastAccess;   // line -> history
+    std::vector<TensorStat> tstats;                  // index tensor + 1
+    int psel = 512;
+    static int curLayer;                             // shared by L2 and L3
+
+    // optional dump of the first dumpMax decisions after the last stats
+    // reset (features, tree decision, final decision) for checking
+    std::ofstream dump;
+    const uint64_t dumpMax;
+    const bool resetHistory;
+    const double sliceBeta;  // thrash protection (0 = off), see access()
+    const bool sliceSizeHint;
+    const bool sliceSizeRatio;   // L2 form of the slice (exact size ratio)
+    const bool l2Alt;            // use taTreeL2Alt (Demand-MIN tree)
+    const double wsAlpha;        // Step 4 working-set slice (0 = off)
+    const bool dirtyAware;       // Step 4 clean-first victim tie-break
+    const bool duelSkipFirst;    // Step 4: PSEL ignores first-touch misses
+    const bool duelLruDefault;   // Step 4: LRU until the tree proves better
+    const bool duelDemandOnly;   // Step 5: PSEL counts demand misses only
+    const bool duelReadsOnly;    // Step 5 fix: PSEL counts demand read misses only
+    const bool treeOff;          // Step 5: learned tree not used (keep = true)
+    const bool sliceContig;      // Step 5: contiguous slice instead of hash
+    const double sliceContigMin; // Step 5: contiguous only if fraction >= this
+    const bool slicePack;            // Step 6: packing plan (whole tensors)
+    std::vector<char> wsPlan;        // tensor -> slice decision applies
+    const uint64_t coordL2Bytes;     // Step 6: L2 size (0 = no coordination)
+    const double coordL2Alpha;
+    const double coordL2ContigMin;
+    const bool coordL2Pack;          // Step 6: the L2 above packs
+    const int l2TreeV3;              // Step 7: learned L2 tree (-1 = off)
+    const uint64_t packMaxLayer;     // Step 7: pack only layers <= this (0 = all)
+    std::vector<char> packedT;       // Step 7: tensor uses the packed plan
+    const bool planAct;              // Step 9: plan reused input activations
+    const bool posByBytes;           // Step 9: position by tensor bytes
+    const bool outStream;            // Step 10: final outputs stream
+    const unsigned bipStream;        // Step 10b: 1-in-N streaming kept
+    const bool setAware;             // Step 11: set-aware plan
+    const unsigned setAwareWays;     // Step 12b: per-set cap (0 = alpha*ways)
+    const bool duelBrrip;            // Step 12: duel against BRRIP mode
+    const bool firstTouch;           // Step 13: first-touch set-aware plan
+    int ftPerSet = 0;
+    mutable std::vector<std::vector<uint8_t>> ftState; // 0 open,1 keep,2 no
+    mutable std::vector<uint64_t> ftUsed;               // kept per tensor
+    std::vector<uint64_t> ftQuota;                      // budget per tensor
+    mutable std::vector<uint16_t> ftCnt;                // kept per set
+    int psel2 = 512;
+    uint64_t brCtr = 0;
+    std::vector<std::vector<bool>> keepBits;  // tensor -> line kept (set-aware)
+    int lineIndex(Addr addr, int tensor) const;
+    uint64_t bipCtr = 0;
+    std::vector<double> tSum;        // Step 9: tensor bytes over its ranges
+    double tensorPos(Addr addr, int tensor) const;
+    const bool coordFit;             // Step 8: coordinate fitting layers too
+    std::vector<char> coordPackedT;  // Step 8: tensor's L2 part is contiguous
+    const bool deadDemote;           // Step 8: dead tensors evicted first
+    const bool bypassStreaming;      // Step 8: L3 bypass of streaming fills
+    uint64_t bypassCount = 0;
+    // hint slice + coordination decision (no side effects); applies = a
+    // slice rule covers this line
+    bool sliceDecision(Addr addr, Addr line, int tensor, bool &applies,
+                       bool *inL2Out = nullptr) const;
+    bool tensorDead(int t) const;
+  public:
+    bool bypass(const PacketPtr pkt) override;
+  protected:
+    std::vector<int> overLog2;       // Step 7: tensor -> log2(layer W / cache)
+    std::vector<double> l2Frac;      // tensor -> L2 slice fraction (as L2)
+    std::vector<double> l3RestFrac;  // tensor -> L3 share of the non-L2 lines
+    std::vector<Addr> tLo, tHi;  // tensor -> lowest / highest physical byte
+    const bool keepPrefetch;     // Step 5: prefetch fills always kept
+    const bool pfByRequestor;    // Step 5 fix: prefetch fills by requestor
+    System *system;
+    std::unordered_map<int, bool> pfRequestor;   // requestor id -> prefetcher
+    bool isPrefetcher(const PacketPtr pkt);
+    std::vector<double> wsFrac;  // tensor -> slice fraction (0 = none)
+    void computeWsFrac();
+    // per-tensor kept fraction for a cache of capBytes (pack or even slice)
+    std::vector<double> planFrac(double capBytes, double alpha, bool pack,
+                                 const std::vector<int> &trole,
+                                 std::vector<char> &plan,
+                                 const std::vector<double> *scale = nullptr) const;
+    uint64_t dumped = 0;
+
+    struct TAStats : public statistics::Group
+    {
+        TAStats(statistics::Group *parent);
+        statistics::Scalar keepDecisions;
+        statistics::Scalar averseDecisions;
+        statistics::Scalar lruLeaderMisses;
+        statistics::Scalar treeLeaderMisses;
+        statistics::Scalar followerTreeAccesses;
+        statistics::Scalar followerLruAccesses;
+        statistics::Scalar tensorAccesses;
+    } taStats;
+
+    void loadHints(const std::string &file);
+    const Range *lookup(Addr addr) const;
+    static int cmdId(const PacketPtr pkt);
+    bool predict(const int *x) const;
+    /** One access (hit or fill): decide keep / not and update the entry. */
+    void access(const std::shared_ptr<ReplacementData>& rd,
+                const PacketPtr pkt, bool fill);
+
+  public:
+    typedef TensorAwareRPParams Params;
+    TensorAware(const Params &p);
+    ~TensorAware() = default;
+
+    /** Start of the measured region (m5_reset_stats): forget the access
+     *  history, as the offline training features start at the ROI. */
+    void resetStats() override;
+
+    void invalidate(const std::shared_ptr<ReplacementData>& replacement_data)
+                                                                    override;
+    void touch(const std::shared_ptr<ReplacementData>& replacement_data,
+               const PacketPtr pkt) override;
+    void touch(const std::shared_ptr<ReplacementData>& replacement_data)
+                                                              const override;
+    void reset(const std::shared_ptr<ReplacementData>& replacement_data,
+               const PacketPtr pkt) override;
+    void reset(const std::shared_ptr<ReplacementData>& replacement_data)
+                                                              const override;
+    ReplaceableEntry* getVictim(const ReplacementCandidates& candidates)
+                                                              const override;
+    std::shared_ptr<ReplacementData> instantiateEntry() override;
+};
+
+} // namespace replacement_policy
+} // namespace gem5
+
+#endif // __MEM_CACHE_REPLACEMENT_POLICIES_TENSOR_AWARE_RP_HH__
